.page {
  padding: 40rpx 32rpx 80rpx;
}

.hero {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #777;
  line-height: 1.5;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 8rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 24rpx;
  color: #888;
}

.value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.value {
  font-size: 34rpx;
  font-variant-numeric: tabular-nums;
}

.chev {
  font-size: 40rpx;
  color: #bbb;
}

.tips {
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.7;
}

.swatches {
  display: flex;
  gap: 24rpx;
  padding-top: 16rpx;
}

.swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.swatch.on {
  border-color: #ffffff;
  box-shadow: 0 0 0 4rpx #333333;
}
